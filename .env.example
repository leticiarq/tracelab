# Backend
TRACELAB_APP_NAME=TraceLab API
TRACELAB_APP_ENV=development
TRACELAB_API_HOST=127.0.0.1
TRACELAB_API_PORT=8000
TRACELAB_DATABASE_URL=sqlite:///./data/tracelab.db
TRACELAB_CORS_ORIGINS=["http://localhost:5173"]
TRACELAB_EVIDENCE_STORAGE_PATH=./backend/data/evidences
TRACELAB_EVIDENCE_MAX_FILE_SIZE=10485760
TRACELAB_EVIDENCE_MAX_FILES_PER_UPLOAD=10
TRACELAB_EVIDENCE_MAX_FILES_PER_LAB=100
TRACELAB_REPORT_EXPORT_MAX_SIZE=52428800
TRACELAB_AI_ENABLED=true
TRACELAB_AI_CONFIG_PATH=./backend/data/ai-settings.json
TRACELAB_AI_MAX_IMAGES=4
TRACELAB_AI_MAX_IMAGE_BYTES=10485760
TRACELAB_AI_MAX_IMAGE_DIMENSION=1600
TRACELAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
TRACELAB_OLLAMA_MODEL=qwen3-vl:2b
TRACELAB_OLLAMA_TIMEOUT_SECONDS=120
TRACELAB_OLLAMA_KEEP_ALIVE=5m

# Frontend
VITE_API_URL=http://127.0.0.1:8000
